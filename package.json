{
  "name": "data-matrix",
  "version": "1.1.7",
  "description": "一个面向文件、网页、结构化数据和嵌套矩阵的二维效率工作区。",
  "author": "AlanFEVM",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlanFEVM/DataMatrix.git"
  },
  "bugs": {
    "url": "https://github.com/AlanFEVM/DataMatrix/issues"
  },
  "homepage": "https://github.com/AlanFEVM/DataMatrix#readme",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "check": "node --check main.js && node --check preload.js && node --check renderer/app.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis portable --publish never && powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/package-portable-zip.ps1"
  },
  "dependencies": {
    "dompurify": "^3.4.12",
    "lucide": "^0.468.0",
    "marked": "^18.0.7"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "io.github.alanfevm.datamatrix",
    "productName": "数据矩阵",
    "executableName": "DataMatrix",
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "DataMatrix-Portable-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "数据矩阵",
      "artifactName": "DataMatrix-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "DataMatrix-Portable-${version}-${arch}.${ext}"
    }
  }
}
